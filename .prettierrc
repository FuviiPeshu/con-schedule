{
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        "^react$",
        "^react-dom",
        "^react-router",
        "<THIRD_PARTY_MODULES>",
        "",
        "^(@/|/)",
        "",
        "^[./]"
    ],
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "printWidth": 100,
    "trailingComma": "es5"
}
